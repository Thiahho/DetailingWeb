# ─────────────────────────────────────────────
# Copiar este archivo a .env.local para desarrollo
# En Vercel: configurar cada variable en Settings > Environment Variables
# ─────────────────────────────────────────────

# URL del backend (Render)
NEXT_PUBLIC_API_URL=https://detailing-api.onrender.com
NEXT_PUBLIC_API_BASE_URL=https://detailing-api.onrender.com

# URL pública del sitio, sin barra final (ej: https://turneo.app). De acá salen
# metadataBase (imágenes Open Graph/Twitter), canonical, sitemap.xml y
# robots.txt. Sin ella el sitemap queda vacío y `next build` avisa que
# metadataBase no está seteado.
NEXT_PUBLIC_SITE_URL=

# Cloudinary (subida de imágenes)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# Gmail SMTP (emails de confirmación desde Next.js)
GMAIL_USER=
GMAIL_APP_PASSWORD=
GMAIL_ADMIN_EMAIL=

# Login de profesionales con Google (OAuth por redirección, ver src/lib/googleOAuth.ts)
# Cliente OAuth "Aplicación web" de Google Cloud Console. La única URI de
# redirección a registrar ahí es GOOGLE_OAUTH_REDIRECT_URI (dominio central, no
# los subdominios de cada negocio). El backend necesita el mismo client id en
# Google__ClientId.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://turneo.app/api/auth/google/callback
# Secreto propio (cualquier string largo y aleatorio) para firmar el `state`
AUTH_STATE_SECRET=
# "true" para mostrar el botón "Continuar con Google"
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false

# Secreto compartido con la API (mismo valor que Proxy__SharedSecret en Render): habilita el rate limiting por IP del visitante
PROXY_SHARED_SECRET=

# Bot de Telegram para avisos a profesionales (usuario, sin @)
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=

# Reseñas y capturas de WhatsApp/Instagram de EJEMPLO en el sitio del salón
# (src/components/public/reviews/demoReviews.ts). Solo se muestran si el salón
# no tiene reseñas reales de Google, y van rotuladas como "Contenido de ejemplo".
# Sin definir: prendido en `next dev`, apagado en producción. "true" lo fuerza
# (deploy de pruebas), "false" lo apaga. No dejar en "true" en el sitio de un
# salón real.
NEXT_PUBLIC_DEMO_REVIEWS=
